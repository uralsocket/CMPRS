<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net48</TargetFramework><OutputType>WinExe</OutputType><LangVersion>7.3</LangVersion><PlatformTarget>x64</PlatformTarget>
  <AssemblyName Condition="'$(Uninstaller)' != 'true'">CMPRS-Setup</AssemblyName>
  <AssemblyName Condition="'$(Uninstaller)' == 'true'">Uninstall</AssemblyName>
  <DefineConstants Condition="'$(Uninstaller)' != 'true'">INSTALLER</DefineConstants>
  <ApplicationIcon>../Dependencies/cmprs.ico</ApplicationIcon><ApplicationManifest>../App/app.manifest</ApplicationManifest>
  <Version>2.0.1</Version><Company>Gleb Karavaev</Company><Product>CMPRS</Product><DebugType>none</DebugType>
  <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
 </PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  <Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" /><Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" /><Reference Include="System.Security" />
  <EmbeddedResource Include="../Build/Payload.zip" LogicalName="CMPRS.Payload" Condition="'$(Uninstaller)' != 'true'" />
 </ItemGroup>
</Project>
