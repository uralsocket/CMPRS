<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><OutputType>WinExe</OutputType>
    <AssemblyName>CMPRS</AssemblyName><RootNamespace>Cmprs</RootNamespace>
    <LangVersion>7.3</LangVersion><PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../Dependencies/cmprs.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.1</Version><Company>Gleb Karavaev</Company><Product>CMPRS</Product>
    <Description>Local Ironclad video compression</Description><DebugType>none</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" /><Reference Include="System.Security" />
    <Compile Include="../Engine/CompressionEngine.cs" Link="CompressionEngine.cs" />
    <None Include="../UI/dist/**" Link="UI/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyWebViewLoader" AfterTargets="Build">
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)/runtimes/win-x64/native/WebView2Loader.dll" DestinationFolder="$(OutputPath)" />
  </Target>
</Project>
